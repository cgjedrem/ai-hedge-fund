{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cgjedrem/ai-hedge-fund/schemas/curated-news-catalog-v1.schema.json",
  "title": "Curated financial news source catalog, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "registry", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "registry": { "$ref": "#/$defs/registry" },
    "sources": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commit", "license", "repository_url", "reviewed_on"],
      "properties": {
        "name": { "const": "plenaryapp/awesome-rss-feeds" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "const": "CC0-1.0" },
        "repository_url": { "const": "https://github.com/plenaryapp/awesome-rss-feeds" },
        "reviewed_on": { "type": "string", "format": "date" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "kind", "publisher", "category", "url", "enabled",
        "allowed_hosts", "scope", "tickers", "cik", "forms", "company_aliases",
        "freshness_seconds", "limits", "curation", "summary_policy", "sequence"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
        "kind": { "enum": ["feed", "sec-edgar"] },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "enum": ["editorial", "investor-relations", "sec-filing", "regulatory", "macro"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "enabled": { "type": "boolean" },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hostname" }
        },
        "scope": { "enum": ["company", "market"] },
        "tickers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,15}$" }
        },
        "cik": { "anyOf": [{ "type": "string", "pattern": "^[0-9]{10}$" }, { "type": "null" }] },
        "forms": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9/-]{0,15}$" }
        },
        "company_aliases": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 120 }
        },
        "freshness_seconds": { "type": "integer", "minimum": 60, "maximum": 31536000 },
        "limits": { "anyOf": [{ "$ref": "#/$defs/limits" }, { "type": "null" }] },
        "curation": { "$ref": "#/$defs/curation" },
        "summary_policy": { "enum": ["none", "feed-supplied"] },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "hostname": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
      "not": { "pattern": "(^|\\.)(yahoo\\.com|yahooapis\\.com)$" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_requests": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_redirects": { "type": "integer", "minimum": 0, "maximum": 3 },
        "max_compressed_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "max_decompressed_bytes": { "type": "integer", "minimum": 1, "maximum": 5242880 },
        "max_entries": { "type": "integer", "minimum": 1, "maximum": 500 },
        "source_deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "minimum_host_interval_seconds": { "type": "number", "minimum": 1, "maximum": 3600 }
      }
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis", "registry_opml_path", "registry_xml_url", "discovery_url",
        "verified_on", "purpose", "rights_note", "approved_by"
      ],
      "properties": {
        "basis": { "enum": ["registry-reviewed", "independently-verified"] },
        "registry_opml_path": { "type": ["string", "null"], "maxLength": 500 },
        "registry_xml_url": { "type": ["string", "null"], "maxLength": 2048 },
        "discovery_url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "verified_on": { "type": "string", "format": "date" },
        "purpose": { "type": "string", "minLength": 10, "maxLength": 500 },
        "rights_note": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "approved_by": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
  }
}
